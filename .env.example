# Background Image URL
# VITE_BG_IMAGE_URL=https://images.unsplash.com/photo-1614850523011-8f49ffc73908?fm=jpg&q=60&w=3000

# Fallback Player Image URL (shown when player image fails to load)
# VITE_FALLBACK_IMAGE_URL=https://images.unsplash.com/photo-1518091043644-c1d4457512c6?fm=jpg&q=60&w=800

# Fallback Background Image URL (secondary background)
# VITE_FALLBACK_BG_IMAGE_URL=https://www.thesun.co.uk/wp-content/uploads/2023/05/CHELSEA_BG_v1.jpg

# Transition Duration in milliseconds
# VITE_TRANSITION_DURATION=500

# Enable/disable keyboard navigation (true/false)
# VITE_KEYBOARD_NAVIGATION_ENABLED=true

# Preload all images on mount (true/false)
# VITE_PRELOAD_ALL_IMAGES=true

# Maximum image load retries
# VITE_MAX_IMAGE_RETRIES=3

# Image retry delay in milliseconds
# VITE_IMAGE_RETRY_DELAY=1000
